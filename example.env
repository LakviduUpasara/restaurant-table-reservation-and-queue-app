# ==============================================================================
# DineFlow - Customer App Environment Variables (example.env)
# 
# Copy this file to: apps/customer-app/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 📱 CUSTOMER APP CONFIGURATION
# ------------------------------------------------------------------------------

# Supabase Project URL (Your hosted Supabase project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (Anon public key for mobile client)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backend API Endpoint
# - For Web preview (browser): http://localhost:3000/api
# - For Android Emulator: http://10.0.2.2:3000/api
# - For Physical Device (Expo Go): http://<YOUR_PC_LAN_IP>:3000/api (e.g. http://192.168.1.50:3000/api)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
