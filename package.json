{
  "name": "dineflow",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run dev -w @dineflow/backend",
    "customer": "npm run start -w @dineflow/customer-app",
    "customer:go": "npm run start:go -w @dineflow/customer-app",
    "customer:tunnel": "npm run start:tunnel -w @dineflow/customer-app",
    "operations": "npm run start -w @dineflow/operations-app",
    "check:hosted-db": "node scripts/check-hosted-db.mjs",
    "seed:staff-demo": "node scripts/seed-staff-demo.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @dineflow/backend"
  },
  "overrides": {
    "expo": "~57.0.30",
    "expo-router": "~57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "eas-cli": "^24.12.1"
  }
}
