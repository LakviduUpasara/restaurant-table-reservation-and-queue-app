# ==============================================================================
# DineFlow - Environment Variables Sample
# ==============================================================================

# ==============================================================================
# 📱 CUSTOMER APP (.env path: apps/customer-app/.env)
# ==============================================================================
# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (From Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Backend API URL (Use localhost for web, 10.0.2.2 for Android emulator, or your computer's LAN IP for physical phone)
EXPO_PUBLIC_API_URL=http://localhost:3000/api


# ==============================================================================
# 🏪 OPERATIONS APP (.env path: apps/operations-app/.env)
# ==============================================================================
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
# EXPO_PUBLIC_API_URL=http://localhost:3000/api


# ==============================================================================
# ⚙️ BACKEND SERVER (.env path: backend/.env)
# ==============================================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
# SUPABASE_SECRET_KEY=sb_secret_your_service_role_secret_key_here
# PORT=3000


# ==============================================================================
# 📧 GMAIL SMTP SETTINGS (Configure in Supabase Dashboard, NOT in mobile .env)
# ==============================================================================
# Go to: Supabase Dashboard -> Project Settings -> Authentication -> SMTP Settings
#
# 1. Enable Custom SMTP: ON
# 2. Sender email: your_gmail@gmail.com
# 3. Sender name: DineFlow
# 4. Host: smtp.gmail.com
# 5. Port: 465
# 6. Encryption: SSL
# 7. Username: your_gmail@gmail.com
# 8. Password: [Your 16-character Google App Password, e.g., abcd efgh ijkl mnop]
# ==============================================================================
