{
  "expo": {
    "name": "DineFlow Customer",
    "slug": "dineflow-customer",
    "scheme": "dineflow-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "lk.dineflow.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "lk.dineflow.customer"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfa3a0be-d046-4724-9dfd-266c41e406dc"
      }
    },
    "owner": "lakvidu04"
  }
}
