{
  "expo": {
    "name": "DineFlow Operations",
    "slug": "dineflow-operations",
    "scheme": "dineflow-operations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F4F4",
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow DineFlow to take a user photo.",
          "photosPermission": "Allow DineFlow to choose user and product photos.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "lk.dineflow.operations",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "userInterfaceStyle": "light"
    },
    "ios": {
      "bundleIdentifier": "lk.dineflow.operations",
      "userInterfaceStyle": "light"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
